# Rust 构建产物（含 Rime 部署缓存 target/rime-user-data）
/target/

# 预编译 librime 由 docs/architecture.md 记载的 release 地址获取，不入库
/third_party/

# rime_deployer 预编译产物（注册脚本部署期生成）
/schemas/build/
/schemas/user.yaml
/schemas/installation.yaml

# Android 构建产物与本机配置
/platforms/android/local.properties
/platforms/android/.gradle/
/platforms/android/build/
/platforms/android/app/build/
/platforms/android/app/src/main/jniLibs/
/prebuilt-tree.json

# 实验性构建目录（CARGO_TARGET_DIR 别名产物）
/target-native-capture/

# Tauri 前端与配置模式生成物
/platforms/windows-settings/ui-dist/
/platforms/windows-settings/gen/
/platforms/windows-installer/gen/

# 本地截图验收生成物，不作为源码或文档资源提交
/screenshot-test/*.bmp
/screenshot-test/*.png

# 安装器/控制中心设计参考素材（外部产品界面截图，仅本地参考，不入库）
/pics/

# 发布产物（安装包、APK、校验和），由 CI/本地构建生成，不入库
/dist/

