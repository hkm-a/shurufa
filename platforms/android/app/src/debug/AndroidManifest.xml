<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".DebugAttachmentReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.shurufa.ime.DEBUG_INJECT_ATTACHMENTS" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".DebugSyncControlReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.shurufa.ime.DEBUG_START_SYNC" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
