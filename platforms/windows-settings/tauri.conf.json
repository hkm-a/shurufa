{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FOX输入法",
  "version": "1.6.0",
  "identifier": "com.shurufa.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "ui-dist"
  },
  "app": {
    "windows": [
      {
        "title": "FOX输入法",
        "label": "main",
        "width": 380,
        "height": 64,
        "minWidth": 40,
        "minHeight": 40,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false
  }
}