# Android 交叉编译配置**样板**。复制为 .cargo/config.toml 后按本机 NDK 路径修改。
#
# 为什么不入库：cargo 的 config 不支持环境变量展开，linker/CC/AR 只能写绝对
# 路径。把某台机器的路径提交进版本库，会让其他机器与 CI 上的交叉编译必然
# 失败，且 ANDROID_NDK_HOME 这类环境变量完全不参与（linker 是配置项不是
# 环境变量），排障成本很高。
#
# 更省事的替代：装 cargo-ndk（fcitx5-android / trime 同款做法），它自动从
# ANDROID_NDK_HOME 推导 linker/CC/AR，无需本文件：
#     cargo install cargo-ndk
#     cargo ndk -t arm64-v8a build --release -p shurufa-rimejni
#
# Android 交叉编译（NDK 28，minSdk 23）。
# 路径写死本机 NDK 位置；换机器时改这里。
[target.aarch64-linux-android]
linker = 'C:\Users\hkm\AppData\Local\Packages\Claude_pzs8sxrjxfjjc\LocalCache\Local\Android\Sdk\ndk\28.0.13004108\toolchains\llvm\prebuilt\windows-x86_64\bin\aarch64-linux-android23-clang.cmd'

[target.x86_64-linux-android]
linker = 'C:\Users\hkm\AppData\Local\Packages\Claude_pzs8sxrjxfjjc\LocalCache\Local\Android\Sdk\ndk\28.0.13004108\toolchains\llvm\prebuilt\windows-x86_64\bin\x86_64-linux-android23-clang.cmd'

# ring（rustls 加密后端）含 C/汇编，交叉编译需指向 NDK 的 clang/ar。
# 变量名带 target 后缀，只影响 android target，不干扰桌面构建。
[env]
CC_aarch64_linux_android = 'C:\Users\hkm\AppData\Local\Packages\Claude_pzs8sxrjxfjjc\LocalCache\Local\Android\Sdk\ndk\28.0.13004108\toolchains\llvm\prebuilt\windows-x86_64\bin\aarch64-linux-android23-clang.cmd'
CXX_aarch64_linux_android = 'C:\Users\hkm\AppData\Local\Packages\Claude_pzs8sxrjxfjjc\LocalCache\Local\Android\Sdk\ndk\28.0.13004108\toolchains\llvm\prebuilt\windows-x86_64\bin\aarch64-linux-android23-clang++.cmd'
AR_aarch64_linux_android = 'C:\Users\hkm\AppData\Local\Packages\Claude_pzs8sxrjxfjjc\LocalCache\Local\Android\Sdk\ndk\28.0.13004108\toolchains\llvm\prebuilt\windows-x86_64\bin\llvm-ar.exe'
CFLAGS_aarch64_linux_android = '--target=aarch64-linux-android23'
CC_x86_64_linux_android = 'C:\Users\hkm\AppData\Local\Packages\Claude_pzs8sxrjxfjjc\LocalCache\Local\Android\Sdk\ndk\28.0.13004108\toolchains\llvm\prebuilt\windows-x86_64\bin\x86_64-linux-android23-clang.cmd'
CXX_x86_64_linux_android = 'C:\Users\hkm\AppData\Local\Packages\Claude_pzs8sxrjxfjjc\LocalCache\Local\Android\Sdk\ndk\28.0.13004108\toolchains\llvm\prebuilt\windows-x86_64\bin\x86_64-linux-android23-clang++.cmd'
AR_x86_64_linux_android = 'C:\Users\hkm\AppData\Local\Packages\Claude_pzs8sxrjxfjjc\LocalCache\Local\Android\Sdk\ndk\28.0.13004108\toolchains\llvm\prebuilt\windows-x86_64\bin\llvm-ar.exe'
CFLAGS_x86_64_linux_android = '--target=x86_64-linux-android23'
